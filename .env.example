# Introo OS - Environment Variables
# Copy this file to .env and fill in your actual values from Supabase Project Settings → API!
#
# VITE_SUPABASE_URL = the "Project URL" from:
#     https://supabase.com/dashboard/project/_/settings/api
#
# VITE_SUPABASE_PUBLISHABLE_KEY = the "anon public" key (SAFE for browsers, RLS enforces permissions).
#     (This was previously called "anon key" in older Supabase docs. Either name works.)
#
# ⚠️ NEVER put the service_role key here — it bypasses Row Level Security and would expose admin access.

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_public_key
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_anon_public_key

